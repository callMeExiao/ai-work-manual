---
import StatusTag from './StatusTag.astro';
import TagList from './TagList.astro';
import ComponentPreview from './ComponentPreview.astro';
import { formatDate, href } from '../lib/content';

interface Props {
  entry: any;
  type: 'workflow' | 'component' | 'article';
  compact?: boolean;
}
const { entry, type, compact = false } = Astro.props;
const data = entry.data;
const path = type === 'workflow' ? `/workflows/${entry.slug}/` : type === 'component' ? `/components/${entry.slug}/` : `/articles/${entry.slug}/`;
---
<article class:list={["content-card", `card-${type}`, { compact }]} data-filter-item data-filter-tags={data.tags.join('|')} data-filter-status={type === 'article' ? data.readingStatus : data.status}>  {type === 'component' && <ComponentPreview preview={data.preview} />}
  <div class="content-card-body">
    <div class="card-topline">
      <span class="index-mark">{type === 'workflow' ? 'W' : type === 'component' ? 'C' : 'A'} / {entry.id.slice(0, 2).toUpperCase()}</span>
      <StatusTag status={type === 'article' ? data.readingStatus : data.status} type={type} />
    </div>
    <h3><a href={href(path)}>{data.title}</a></h3>
    <p class="card-description">{data.description}</p>
    {type === 'workflow' && (
      <div class="card-facts"><span><b>输入</b>{data.input}</span><span><b>输出</b>{data.output}</span><span><b>验证</b>{formatDate(data.lastVerified)}</span></div>
    )}
    {type === 'component' && (
      <div class="card-facts"><span><b>{data.category}</b>{data.technology.join(' / ')}</span><span><b>判断</b>{data.used ? '已在实践中' : '等待试用'}</span></div>
    )}
    {type === 'article' && (
      <div class="card-facts"><span><b>作者</b>{data.author}</span><span><b>来源</b>{data.source}</span></div>
    )}
    <div class="card-footer">
      <TagList tags={data.tags} />
      <a class="text-link" href={href(path)} aria-label={`阅读${data.title}`}>查看条目 <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>
