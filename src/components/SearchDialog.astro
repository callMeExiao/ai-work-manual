<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-dialog-inner">
    <div class="search-dialog-head">
      <div>
        <p class="eyebrow">QUICK FIND / 01</p>
        <h2 id="search-title">搜索工作手册</h2>
      </div>
      <button class="icon-button" type="button" data-close-search aria-label="关闭搜索">×</button>
    </div>
    <label class="search-field">
      <span class="sr-only">搜索标题、描述或标签</span>
      <span aria-hidden="true">⌕</span>
      <input type="search" data-search-input placeholder="输入标题、标签或关键词" autocomplete="off" />
      <kbd>ESC</kbd>
    </label>
    <div class="search-results" data-search-results aria-live="polite">
      <p class="search-hint">正在读取索引…</p>
    </div>
  </div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-open-search]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-close-search]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  const base = document.documentElement.dataset.base?.replace(/\/$/, '') ?? '';
  let index: Array<{ title: string; description: string; type: string; tags: string[]; path: string }> = [];

  const typeNames: Record<string, string> = { workflows: '工作流', components: '组件库', articles: '文章' };
  const renderHint = (message: string) => {
    if (!results) return;
    const hint = document.createElement('p');
    hint.className = 'search-hint';
    hint.textContent = message;
    results.replaceChildren(hint);
  };
  const renderResults = (query = '') => {
    if (!results) return;
    const normalized = query.trim().toLowerCase();
    const matches = index.filter((item) => {
      const haystack = [item.title, item.description, item.type, ...item.tags].join(' ').toLowerCase();
      return !normalized || haystack.includes(normalized);
    }).slice(0, 8);
    if (!matches.length) {
      renderHint('没有找到匹配的条目。');
      return;
    }
    const fragment = document.createDocumentFragment();
    matches.forEach((item) => {
      const link = document.createElement('a');
      link.className = 'search-result';
      link.href = `${base}${item.path}`;
      const type = document.createElement('span');
      type.className = 'search-result-type';
      type.textContent = typeNames[item.type] ?? item.type;
      const body = document.createElement('span');
      body.className = 'search-result-body';
      const title = document.createElement('strong');
      title.textContent = item.title;
      const description = document.createElement('small');
      description.textContent = item.description;
      body.append(title, description);
      const arrow = document.createElement('span');
      arrow.className = 'search-result-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '↗';
      link.append(type, body, arrow);
      fragment.append(link);
    });
    results.replaceChildren(fragment);
  };
  const openSearch = async () => {
    if (!dialog) return;
    dialog.showModal();
    input?.focus();
    if (!index.length) {
      try {
        const response = await fetch(`${base}/search-index.json`);
        index = await response.json();
        renderResults(input?.value ?? '');
      } catch {
        renderHint('索引暂时不可用，请使用栏目浏览。');
      }
    }
  };
  openButton?.addEventListener('click', openSearch);
  closeButton?.addEventListener('click', () => dialog?.close());
  input?.addEventListener('input', () => renderResults(input.value));
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
    if (event.key === 'Escape' && dialog?.open) dialog.close();
  });
</script>
